# Optional. Not needed if you are in the `input` group - which is the
# simpler, more common setup, and what docs/install.md recommends.
#
# This rule gives local seat users read access to *keyboards only* through
# logind's ACLs instead of through group membership. Install it only if you
# would rather not add users to `input`:
#
#   sudo install -Dm644 dist/keyvibes-udev.rules /etc/udev/rules.d/70-keyvibes-uaccess.rules
#   sudo udevadm control --reload-rules && sudo udevadm trigger
#
# `ID_INPUT_KEYBOARD` is set by udev's own input_id helper, so this matches
# only devices the kernel already classifies as keyboards - not mice, not
# power buttons, not touchpads. It grants nothing to remote sessions,
# containers, or users without an active seat - exactly the property that
# makes it preferable to a blanket group change when it applies to you.
#
# KeyVibes never grabs, injects, or writes to these devices: it only reads
# key codes to choose a sound, then forgets them. See docs/linux-permissions.md.
SUBSYSTEM=="input", KERNEL=="event*", ENV{ID_INPUT_KEYBOARD}=="1", TAG+="uaccess"
